# Production Environment Variables for Railway
# Note: DOCKER_TARGET and DOCKER_HOST should NOT be set in production
# Docker is only available in local development with docker-compose
# Values should be configured in the deployment provider (Railway),
# not self-referenced in this file.

# Database
# MONGODB_URI=

# Authentication
# JWT_SECRET=

# Redis Cache
# REDIS_PASSWORD=

# Firebase (Frontend Config)
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# AI Service
# GROQ_API_KEY=

# Environment
NODE_ENV=production
