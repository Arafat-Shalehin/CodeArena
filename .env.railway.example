# Railway Deployment - Environment Variables Template
# Copy all these values to Railway dashboard → Variables

# Database Configuration
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/<db_name>?retryWrites=true&w=majority

# Application Configuration
NODE_ENV=production
JWT_SECRET=your-jwt-secret

# Redis Configuration (if using Railway Redis)
REDIS_PASSWORD=SuperStrongRedisPassword
REDIS_HOST=redis
REDIS_PORT=6379

# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id

# API Keys
GROQ_API_KEY=your-groq-api-key

# Database User (for local MongoDB if not using Atlas)
DB_USER=admin
DB_PASSWORD=your-db-password

# Docker Configuration (May not work on Railway - Docker is for build time only)
DOCKER_HOST=http://docker-proxy:2375
DOCKER_TARGET=//./pipe/docker_engine

# Execution Service Configuration
# Use this when execution service is deployed separately (recommended for Railway)
EXECUTION_SERVICE_URL=http://your-execution-service:4000
EXECUTION_SERVICE_API_KEY=your-secret-api-key
EXECUTION_SERVICE_TIMEOUT=90000

# Judge0 Fallback (used when execution service is unavailable)
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your-judge0-api-key

# Notes:
# - MONGODB_URI takes precedence over DB_USER/DB_PASSWORD
# - REDIS_HOST should point to Railway Redis service if using that
# - DOCKER_HOST won't work in Railway cloud (only for local development)
# - All NEXT_PUBLIC_* variables are exposed to frontend
# - Keep JWT_SECRET and API keys secure
# - EXECUTION_SERVICE_URL: Point to your deployed execution service (required for code execution)
# - If execution service is down, it will fallback to Judge0 API
